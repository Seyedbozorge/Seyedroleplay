<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:orientation="vertical"
    android:padding="20dp"
    android:layoutDirection="rtl">

    <!-- کارت وضعیت سرور -->
    <TextView
        android:id="@+id/txtServerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#111C2E"
        android:padding="16dp"
        android:text="وضعیت سرور: در حال بررسی..."
        android:textColor="#239F40"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- دکمه اصلی ورود به بازی -->
    <Button
        android:id="@+id/btnPlay"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#239F40"
        android:text="ورود به بازی"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- دکمه‌های ورود و ثبت‌نام -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#111C2E"
            android:text="ورود"
            android:textColor="#FFFFFF" />

        <Space
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#111C2E"
            android:text="ثبت‌نام"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- دکمه تنظیمات -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#111C2E"
        android:text="تنظیمات"
        android:textColor="#FFFFFF" />

</LinearLayout>
